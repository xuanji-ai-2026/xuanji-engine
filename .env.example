# Application Configuration
APP_NAME=玄玑AI数字员工引擎
APP_VERSION=2.0
APP_ENVIRONMENT=production
DEBUG=False

# API Configuration
API_HOST=0.0.0.0
API_PORT=8080
API_WORKERS=4
API_TIMEOUT=60

# DeepSeek Configuration
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_TIMEOUT=30
DEEPSEEK_MAX_RETRIES=3

# Feishu Configuration
FEISHU_APP_ID=your_feishu_app_id_here
FEISHU_APP_SECRET=your_feishu_app_secret_here
FEISHU_ENCRYPT_KEY=your_feishu_encrypt_key_here
FEISHU_VERIFICATION_TOKEN=your_feishu_verification_token_here

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=xuanji_engine
DB_USER=xuanji
DB_PASSWORD=your_db_password_here
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your_redis_password_here
REDIS_POOL_SIZE=10
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_MAX_CONNECTIONS=50

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_OUTPUT=stdout
LOG_FILE=/var/log/xuanji-engine/app.log
LOG_MAX_SIZE=100M
LOG_BACKUP_COUNT=10

# Monitoring Configuration
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics
HEALTH_CHECK_PATH=/health
READY_CHECK_PATH=/ready

# Performance Configuration
PERFORMANCE_MAX_CONCURRENT_REQUESTS=1000
PERFORMANCE_REQUEST_TIMEOUT=60
PERFORMANCE_CONNECTION_TIMEOUT=10
PERFORMANCE_KEEPALIVE_TIMEOUT=5
PERFORMANCE_MAX_KEEPALIVE_CONNECTIONS=100

# Security Configuration
SECRET_KEY=your_secret_key_here_change_in_production
JWT_SECRET_KEY=your_jwt_secret_key_here_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
CORS_ORIGINS=https://xuanji-engine.xuanji-ai.com,https://app.xuanji-ai.com
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Feature Flags
FEATURE_INTENT_RECOGNITION=true
FEATURE_REACT_ENGINE=true
FEATURE_MEMORY=true
FEATURE_PERSONALITY=true
FEATURE_PLUGIN_SYSTEM=true
FEATURE_EXECUTOR=true
FEATURE_K8S_CONFIG=true
FEATURE_SECURITY=true
FEATURE_DIALOGUE=true
FEATURE_OPENAPI=true
